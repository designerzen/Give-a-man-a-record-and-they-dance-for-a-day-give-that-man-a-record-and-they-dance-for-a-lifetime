extends _base.pug

block title
	title Talks by Zenon Olenski

block headline
	| Talks by Zenon Olenski

block tagline
	| Give a man a record and they dance for a day, give that man a synthesizer and they dance for a lifetime

block main
	main#app
		ul.talks
			li
				a(href="./talk.html")
					img(src="/static/talk/wheel.png", alt="", loading="lazy")
					strong PhotoSYNTH
					span From the wheel to the synthesizer
			li
				a(href="./talk-rix.html")
					img(src="/static/talk/MDL - Robot war.png", alt="", loading="lazy")
					strong RIX
					span Music, machines and AI
			li
				a(href="./iop.html")
					img(src="/static/talk/RCA MK2.png", alt="", loading="lazy")
					strong Institute of Physics
					span The physics of making music

		p
			| Slides for talks about
			a(href="https://interface.place") PhotoSYNTH
			| . Press
			kbd S
			|  in a deck for speaker notes.

block styles
	style.
		body{ margin: 0; line-height: 1.5; }
		#intro, #app{ max-width: 64rem; margin: 0 auto; padding: 0 1.5rem; }
		#intro{ padding-top: 3rem; }
		#intro h1{ margin: 0; font-size: clamp(2rem, 6vw, 3.5rem); line-height: 1.1; }
		#intro h2{ margin: .75rem 0 2rem; font: 400 1.25rem/1.4 'ReadexPro', sans-serif; max-width: 40ch; }
		.talks{ list-style: none; padding: 0; display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr)); }
		.talks a{ display: flex; flex-direction: column; gap: .25rem; color: inherit; text-decoration: none; }
		.talks img{ width: 100%; aspect-ratio: 3 / 2; object-fit: cover; margin-bottom: .5rem; border: 1px solid #0002; }
		.talks strong{ font-size: 1.25rem; color: var(--col-accent); }
		.talks a:is(:hover, :focus-visible) strong{ text-decoration: underline; }
